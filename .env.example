NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/decompo
ADMIN_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH
JWT_SECRET=replace_with_secure_secret
CONSENT_RETENTION_DAYS=365
LOG_RETENTION_DAYS=90
ALLOWED_HOSTS=localhost,127.0.0.1
QWEN_ENABLE_MOCK=true
CONFIG_ENCRYPTION_KEY=replace-with-32-char-secret
