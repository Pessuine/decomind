{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noImplicitAny": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "shared": ["packages/shared/src"],
      "config": ["packages/config/src"],
      "database": ["packages/database/src"]
    }
  }
}
